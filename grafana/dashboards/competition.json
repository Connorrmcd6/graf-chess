    {
      "title": "Rapid rating journey",
      "type": "timeseries",
      "description": "Post-game ratings from available archives. No starting ratings or missing history are inferred.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "postgres",
        "uid": "chess-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "chess-postgres"
          },
          "rawSql": "SELECT g.ended_at AS time, g.rating AS value, g.name AS metric\n          FROM dashboard.games g CROSS JOIN dashboard.competition c\n          WHERE g.rated AND g.rules = 'chess' AND g.mode = 'rapid'\nAND g.ended_at >= c.starts_at AND g.ended_at < c.ends_at ORDER BY time",
          "format": "time_series",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
