    {
      "title": "12 weeks. One leaderboard.",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Highest rapid rating at the deadline wins.** Complete **20 rated rapid games** to qualify. 08 Aug - 31 Oct 2026, 00:00 SAST. Equal ratings share a rank.\n\nUpdates can lag behind Chess.com."
      },
      "id": 1
    },
    {
      "title": "Competition status",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 3
      },
      "datasource": {
        "type": "postgres",
        "uid": "chess-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "chess-postgres"
          },
          "rawSql": "SELECT CASE WHEN finalized_at IS NOT NULL THEN 'FINAL'\n          WHEN now() >= ends_at THEN 'PROVISIONAL - awaiting review'\n          WHEN now() < starts_at THEN 'NOT STARTED' ELSE 'IN PROGRESS' END AS status\n          FROM dashboard.competition",
          "format": "table",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "spanNulls": true,
            "lineInterpolation": "stepAfter",
            "minWidth": 60
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 2
    },
    {
