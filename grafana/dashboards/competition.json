    {
      "title": "Details and game links",
      "type": "row",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "title": "Exact standings",
          "type": "table",
          "description": "",
          "gridPos": {
            "x": 0,
            "y": 38,
            "w": 24,
            "h": 8
          },
          "datasource": {
            "type": "postgres",
            "uid": "chess-postgres"
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "postgres",
                "uid": "chess-postgres"
              },
              "rawSql": "SELECT rank AS \"Rank\", name AS \"Player\", rating AS \"Rapid rating\",\n          games AS \"Games\", wins AS \"Wins\", draws AS \"Draws\", losses AS \"Losses\",\n          round(100.0 * wins / nullif(games, 0), 1) AS \"Win %\", last_game_at AS \"Last game\"\n          FROM dashboard.standings ORDER BY rank NULLS LAST, name",
              "format": "table",
              "rawQuery": true
            }
