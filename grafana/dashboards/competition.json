            "type": "postgres",
            "uid": "chess-postgres"
          },
          "rawSql": "SELECT s.name || ' (' || s.games || ' / ' || c.minimum_games || ')' AS \"Player\",\n         least(s.games, c.minimum_games) AS \"Games toward qualification\"\n         FROM dashboard.standings s CROSS JOIN dashboard.competition c ORDER BY s.games DESC, s.name",
          "format": "table",
